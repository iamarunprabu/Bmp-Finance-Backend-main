<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="investment_report"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    whenNoDataType="BlankPage">

    <parameter name="reportTitle"
               class="java.lang.String"/>

    <field name="id"
           class="java.lang.Long"/>
    <field name="createdBy"
           class="java.lang.String"/>
    <field name="inversmentAmt"
           class="java.lang.Double"/>
    <field name="createdDt"
           class="java.util.Date"/>

    <variable name="totalAmount"
              class="java.lang.Double"
              calculation="Sum">
        <variableExpression><![CDATA[$F{inversmentAmt}]]></variableExpression>
    </variable>

    <title>
        <band height="60">
            <textField>
                <reportElement x="0"
                               y="10"
                               width="555"
                               height="25"/>
                <textElement textAlignment="Center"><font size="16" isBold="true"/></textElement>
                <textFieldExpression>
                    <![CDATA[$P{reportTitle}]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0"
                               y="35"
                               width="555"
                               height="20"/>
                <textElement textAlignment="Center"><font size="10"/></textElement>
                <textFieldExpression>
                    <![CDATA["Generated on: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm:ss").format(new java.util.Date())]]>
                </textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="30" backcolor="#E8E8E8"/>
            </rectangle>
            <staticText>
                <reportElement x="10"
                               y="5"
                               width="200"
                               height="20"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Partner Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="250"
                               y="5"
                               width="100"
                               height="20"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Amount]]></text>
            </staticText>
            <staticText>
                <reportElement x="380"
                               y="5"
                               width="165"
                               height="20"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="10"
                               y="0"
                               width="200"
                               height="25"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression>
                    <![CDATA[$F{createdBy} != null ? $F{createdBy} : "N/A"]]>
                </textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="250"
                               y="0"
                               width="100"
                               height="25"/>
                <textElement textAlignment="Right"><font size="11"/></textElement>
                <textFieldExpression>
                    <![CDATA[$F{inversmentAmt} != null ? $F{inversmentAmt} : 0.0]]>
                </textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="dd/MM/yyyy">
                <reportElement x="380"
                               y="0"
                               width="165"
                               height="25"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression>
                    <![CDATA[$F{createdDt}]]>
                </textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="40" splitType="Stretch">
            <staticText>
                <reportElement x="180"
                               y="10"
                               width="70"
                               height="20"/>
                <textElement textAlignment="Right"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Total:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="250"
                               y="10"
                               width="100"
                               height="20"/>
                <textElement textAlignment="Right"><font size="11" isBold="true"/></textElement>
                <textFieldExpression>
                    <![CDATA[$V{totalAmount} != null ? $V{totalAmount} : 0.0]]>
                </textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>